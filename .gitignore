# Xcode
DerivedData/
*.xcuserstate
xcuserdata/
build/

# Local secrets (never commit)
Config/Secrets.xcconfig
AppStore/certs/

# Dev artifacts
.dev-screenshot.png

# Local Resend/Supabase tokens for setup scripts
.env.resend

# Finder duplicate copies ("File 2.swift") — Xcode auto-compiles the whole
# synced folder, so these cause Invalid redeclaration build failures.
**/* [0-9].swift
**/* [0-9].js
**/* [0-9].tsx
**/* [0-9].ts
**/* [0-9].css
